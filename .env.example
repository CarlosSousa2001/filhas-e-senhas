# Ambiente: development | test | production
NODE_ENV=development

# Servidor HTTP
HOST=0.0.0.0
PORT=3333

# Segredo JWT de exemplo; substitua por um segredo próprio (mínimo 32 caracteres).
JWT_SECRET=example-only-change-this-jwt-secret-32-characters

# Documentação da API (Scalar em /docs). Padrão: ligada em development, desligada em production.
DOCS_ENABLED=true

# Postgres local do Docker Compose (credenciais apenas para desenvolvimento).
# POSTGRES_PORT muda a porta exposta no seu computador (use se a 5432 já estiver ocupada;
# nesse caso, ajuste a porta também nas URLs abaixo).
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/senhas
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/senhas_test
